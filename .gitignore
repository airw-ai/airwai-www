# MkDocs build artifact
site/

# Generated pages — build.py writes docs/<page>/index.html from src/ + _partials/;
# CI rebuilds them on every deploy, so they are not tracked (source of truth is src/).
# NOTE: docs/assets/, docs/CNAME, and docs/.nojekyll ARE tracked — build.py preserves
# (does not regenerate) them, so they must stay in the repo.
docs/index.html
docs/**/index.html

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# OS / Office leftovers
~$*

# Node
node_modules/

# Local dev / Cloudflare artifacts (the Worker itself lives in a private repo;
# real secrets are write-only via `wrangler secret put` and are never committed).
.wrangler/
.dev.vars
.dev.vars.local

# Design-canvas scratch — belongs in the design-system repo, not this public
# marketing repo. Kept out to avoid shipping large working files publicly.
_design-canvas/
